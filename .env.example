# Deployment env for the docker-compose.prod.yml stack. Copy to .env and fill in.
# Every var here is either read directly by backend/src (see backend/src/core/config/*.js) or
# is a container-bootstrap var the compose file needs (marked below). Placeholders only —
# real values live in the deployment's own secret store, never in this file or git.
#
# Where a value appears twice (POSTGRES_PASSWORD / POSTGRES_URL, RABBITMQ_USER+PASSWORD /
# CLOUDAMQP_URL) the two must be kept in sync by hand: one is the container's own bootstrap
# var, the other is the full DSN the backend connects with.

# --- Server ---------------------------------------------------------------------------------
# Without PORT: defaults to 3000. Must match the host port mapping in docker-compose.prod.yml.
PORT=3000
# development enables verbose behavior in a few places; the backend does not hard-require
# production, but this stack is deployment, so set it.
NODE_ENV=production
# Without LOG_LEVEL: defaults to info. Winston level (error|warn|info|debug).
LOG_LEVEL=info
# Without ALLOWED_ORIGINS: server.js falls back to a hardcoded dev list (two specific
# chrome-extension ids + localhost). Any other origin's browser requests are CORS-rejected.
# Comma separated, no spaces.
ALLOWED_ORIGINS=chrome-extension://<extension-id>,https://your-frontend-origin

# --- Postgres (bootstrap vars, read by the postgres container image, not by backend code) ---
# Without POSTGRES_PASSWORD: the postgres container refuses to start.
POSTGRES_PASSWORD=changeme-postgres-password
# Without POSTGRES_DB: defaults to "concize" in docker-compose.prod.yml.
POSTGRES_DB=concize

# --- Postgres (read by backend/src/core/config/database.js) ---------------------------------
# Without POSTGRES_URL: performSystemCheck() at boot fails "SELECT 1", process exits 1.
# Must embed the same password as POSTGRES_PASSWORD above. Host is the compose service name.
POSTGRES_URL=postgres://postgres:changeme-postgres-password@postgres:5432/concize
# Without PGSSL=disable: infra/postgres.js requests TLS (rejectUnauthorized:false). The
# in-stack postgres:16 image does not speak TLS, so the connection fails unless this is set.
# A managed/external Postgres usually needs TLS — drop this var in that case.
PGSSL=disable
# Without PG_POOL_MAX: defaults to 10 connections.
PG_POOL_MAX=10

# --- Qdrant (read by backend/src/core/config/database.js) -----------------------------------
# Without QDRANT_URL: performSystemCheck()'s getCollections() call fails at boot, process exits 1.
QDRANT_URL=http://qdrant:6333
# Optional. The in-stack qdrant/qdrant image runs without auth by default; only set this if
# Qdrant is deployed with QDRANT__SERVICE__API_KEY set to the same value.
QDRANT_API_KEY=
# Two collection-naming paths coexist. The retrieval path actually in use
# (transcript/pipeline.wiring.js -> chat/chunk.search.js) ignores these vars: it creates a
# collection named literally "concize_chunks" at api boot regardless (verified: booting this
# stack with these vars set still produced only a "concize_chunks" Qdrant collection, nothing
# named after either var). An older embedding path (chat/vector.search.js,
# providers/embedding/*.embedding.js) does read them — without a value it calls Qdrant with an
# undefined collection name and fails at call time, not at boot. Set them anyway.
TRANSCRIPTION_COLLECTION=transcriptions
CHAT_COLLECTION=chats

# --- RabbitMQ (bootstrap vars, read by the rabbitmq container image) -------------------------
# Without these: rabbitmq falls back to the "guest" account, which most RabbitMQ images
# restrict to loopback-only connections — a container-to-container connection from api/
# summary-worker would then be refused.
RABBITMQ_USER=changeme-rabbitmq-user
RABBITMQ_PASSWORD=changeme-rabbitmq-password

# --- Queue (read by backend/src/core/config/queues.js) ---------------------------------------
# Without CLOUDAMQP_URL: performSystemCheck() fails to connect at boot, process exits 1. Also
# read directly by summary.worker.js's own startup. Must embed the same credentials as
# RABBITMQ_USER/RABBITMQ_PASSWORD above.
CLOUDAMQP_URL=amqp://changeme-rabbitmq-user:changeme-rabbitmq-password@rabbitmq:5672
# Without SUMMARY_QUEUE: defaults to "summary_queue". Must be the same value for api and
# summary-worker — they are two containers from the same image reading the same var.
SUMMARY_QUEUE=summary_queue

# --- Redis (read by backend/src/core/config/database.js) -------------------------------------
# Optional, lazy: idempotency / rate-limit cooldowns. Not in this compose file — add a redis
# service and point this at it if a feature that needs it is enabled. Nothing fails at boot
# without it; features that need Redis fail at the point they're used.
REDIS_URL=

# --- Auth (read by backend/src/core/config/auth.js) -------------------------------------------
# This choice decides whether /rt, the live recording socket, can authenticate at all.
# See Concize-KB/40-roadmap/deployment.md before setting it.
#
# hs256: this deployment issues its own tokens. /api/v1/auth/signup and /api/v1/auth/login are
# mounted, accounts live in the users table, and no external identity provider is required.
# jwks: delegate to Supabase. Those two routes are not mounted, and SUPABASE_JWKS_URI must be
# reachable from the container at every verification, not only at boot.
AUTH_MODE=hs256

# hs256 only. Anyone holding this can mint a token for any account, so generate a long random
# value and keep it out of the repo.
AUTH_JWT_SECRET=generate_a_long_random_secret
AUTH_JWT_ISSUER=concize

# jwks only. Ignored under hs256.
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated

# --- Inference providers (read by backend/src/core/config/inference.js) ----------------------
# Comma separated, rotated per call. Without keys for a task's configured provider: that
# feature 413s/fails at call time, not at boot (index.js only warns).
SARVAM_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=

# Without *_PROVIDER/*_MODEL: fall back to the hardcoded defaults in inference.js (cerebras /
# llama3.1-8b for chat/clean/summary, sarvam / saaras:v1 for transcription) — check those are
# actually what you want before relying on the fallback.
TRANSCRIPTION_PROVIDER=sarvam
TRANSCRIPTION_MODEL=saaras:v1
CHAT_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b
CLEAN_PROVIDER=groq
CLEAN_MODEL=openai/gpt-oss-120b
SUMMARY_PROVIDER=groq
SUMMARY_MODEL=openai/gpt-oss-120b
# Without SARVAM_BATCH_MODEL: defaults to saaras:v3 for the batch reconciliation pass.
SARVAM_BATCH_MODEL=saaras:v3

# Answer-token ceilings, optional. Each falls back to the hardcoded default in inference.js if
# unset (chat 1200, clean 1500). Counts against the same per-request limit as the prompt
# (backend/src/core/provider.limits.js) — too high for the model leaves too little room for
# retrieved context and 413s.
CHAT_MAX_TOKENS=1200
CLEAN_MAX_TOKENS=1500
# Optional. Caps how much context retrieval may spend; null (unset) derives it from the model.
CHAT_CONTEXT_TOKENS=

# --- Per-provider rate limiting (read by backend/src/providers/llm/resilient.inference.js) ---
# Optional, dynamically named: <PROVIDER>_MAX_CONCURRENT and <PROVIDER>_MIN_TIME_MS for
# whichever provider string is in play (GROQ_MAX_CONCURRENT, CEREBRAS_MIN_TIME_MS, etc — the
# provider name uppercased). Without them: falls back to LLM_MAX_CONCURRENT (also optional),
# then to the measured ceilings in backend/src/core/provider.limits.json, then to a hardcoded
# 6. Not enumerated here since the var name depends on which provider you configure above; set
# them only if the defaults are producing 429s or leaving throughput on the table.
LLM_MAX_CONCURRENT=

# --- Speaker attribution (read by backend/src/server.js and providers/speaker/funasr.lane.js) -
# Without SPEAKER_SERVICE_URL: server.js does not build the speaker lane at all — meetings
# still transcribe, just unattributed. Point it at the speaker-service container.
SPEAKER_SERVICE_URL=ws://speaker-service:8765/speaker
# Without SPEAKER_PORT: docker-compose.prod.yml maps host 8765 by default.
SPEAKER_PORT=8765

# --- Audio storage (read by backend/src/core/config/storage.js) ------------------------------
# Without these: cloudinary.config() itself does not throw (it just stores blank values, no
# validation), so the server still boots — but every audio upload/fetch fails at call time
# with a Cloudinary auth error, so meetings cannot store or retrieve their recording.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Chunking tuning (read by backend/src/core/config/chunking.js) ---------------------------
# All optional; each falls back to the default shown if unset.
CHUNK_GAP_THRESHOLD=3.0
MIN_TURN_TOKENS=10
MAX_CHUNK_TOKENS=500
MIN_CHUNK_TOKENS=50

# --- Transcription filtering (read by backend/src/core/config/inference.js) ------------------
SILENCE_THRESHOLD=0.5
CONFIDENCE_FLOOR=-0.5
SARVAM_POLL_INTERVAL_MS=5000
SARVAM_MAX_WAIT_MS=300000

# --- Meeting recording / reconciliation (read directly via process.env, no config/ module) ---
# Without RECORDING_DIR: the meeting is never spooled to disk, so transcript/reconcile.wiring.js
# never runs its post-meeting correction pass for that meeting — the live transcript stands as
# final. Off by default deliberately: a three hour meeting is ~345MB of wav.
RECORDING_DIR=
# Only read if RECORDING_DIR is set. Without KEEP_RECORDING=true, the wav is deleted once the
# reconciliation pass that needed it finishes.
KEEP_RECORDING=false

# --- Misc (read directly via process.env, no config/ module) ---------------------------------
# Without USAGE_LEDGER_DIR: usage.ledger.js writes to /tmp, which is fine in a container but
# is wiped on every restart — set this to a mounted volume if usage history should persist.
USAGE_LEDGER_DIR=/tmp
# Prefixes queue names (queues.js AUDIO_QUEUE) to isolate environments sharing one broker.
# Leave empty for a dedicated broker (this stack has one).
DEV_PREFIX=

# --- Speaker service ---
# HuggingFace token, for the overlapped-speech detector (pyannote/segmentation-3.0).
# Without it the speaker service still runs, logs one warning, and reports no overlap:
# contested speech is then attributed to a single speaker with no hedging.
# Costs throughput, measured 14.7x real time down to about 6x on CPU.
HF_TOKEN=hf_your_token_here
