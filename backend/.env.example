# Copy to .env and fill in. Nothing here is a real credential.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=chrome-extension://<extension-id>,http://localhost:3000

# --- Postgres -----------------------------------------------------------------
# Local container from docker-compose.dev.yml. A managed instance usually needs SSL,
# in which case drop PGSSL.
POSTGRES_URL=postgres://postgres:local@127.0.0.1:55432/concize
PGSSL=disable
PG_POOL_MAX=10

# --- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:56333
QDRANT_API_KEY=
TRANSCRIPTION_COLLECTION=transcriptions
CHAT_COLLECTION=chats

# --- Queue and cache ----------------------------------------------------------
CLOUDAMQP_URL=amqp://guest:guest@127.0.0.1:55672
SUMMARY_QUEUE=summary_queue
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---------------------------------------------------------------------
# jwks verifies Supabase tokens against their published keys. hs256 with a shared
# secret is easier locally, where you mint your own tokens.
AUTH_MODE=jwks
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_SECRET=

# Legacy shared-code auth, kept during the migration. Turn it off in production.
LEGACY_AUTH_ENABLED=true
ALLOWED_AUTH_CODES=
LEGACY_OWNER_ID=legacy-owner

# --- Providers ----------------------------------------------------------------
# Each accepts a comma separated list and rotates per call.
SARVAM_API_KEYS=
GROQ_API_KEYS=
CEREBRAS_API_KEYS=
GEMINI_API_KEYS=

TRANSCRIPTION_PROVIDER=sarvam
TRANSCRIPTION_MODEL=saaras:v1
CHAT_PROVIDER=groq
CHAT_MODEL=openai/gpt-oss-120b
CLEAN_PROVIDER=groq
CLEAN_MODEL=openai/gpt-oss-120b
SUMMARY_PROVIDER=groq
SUMMARY_MODEL=openai/gpt-oss-120b

# --- Speaker attribution ------------------------------------------------------
# Leave unset to run without it. Meetings still transcribe, just unattributed.
SPEAKER_SERVICE_URL=

# --- Audio storage ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Tuning -------------------------------------------------------------------
CHUNK_GAP_THRESHOLD=3.0
MIN_TURN_TOKENS=10
MAX_CHUNK_TOKENS=500
MIN_CHUNK_TOKENS=50
SILENCE_THRESHOLD=0.5
CONFIDENCE_FLOOR=-0.5
SARVAM_POLL_INTERVAL_MS=5000
SARVAM_MAX_WAIT_MS=300000
